pkgname=fcitx5-sime
pkgver=2026.04.29
pkgrel=13
pkgdesc="Sime Chinese input method for Fcitx5"
arch=("x86_64")
url="https://github.com/Ismantic/SimeApp"
license=("Apache-2.0")
depends=("fcitx5")
makedepends=("cmake" "gcc" "make")
source=()
sha256sums=()

_appdir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
_enginedir="${SIME_ENGINE_ROOT:-$(cd "$_appdir/../Sime" && pwd)}"

build() {
  cmake -S "$_appdir/Linux/fcitx5" -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DSIME_ENGINE_ROOT="$_enginedir"
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  install -dm755 "$pkgdir/usr/share/sime"
  install -m644 "$_enginedir/pipeline/output/sime.dict" \
    "$pkgdir/usr/share/sime/sime.dict"
  install -m644 "$_enginedir/pipeline/output/sime.cnt" \
    "$pkgdir/usr/share/sime/sime.cnt"
}
